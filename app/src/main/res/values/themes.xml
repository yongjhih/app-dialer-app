<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Translucent floating overlay: show home screen behind a small dialer card.
      Parent keeps Material attrs for Compose while framework translucency flags
      make the activity window itself see-through (not solid black).
    -->
    <style name="Theme.AppDialer" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#FFD700</item>
        <item name="colorSecondary">#28282E</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Translucent window & immediate system starting preview -->
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">#66000000</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowElevation">0dp</item>

        <!-- Enable immediate system preview to eliminate 0.5s ActivityTaskManager launch delay -->
        <item name="android:windowDisablePreview">false</item>

        <!-- Downward Fade Out window animation on exit (no side slide) -->
        <item name="android:windowAnimationStyle">@style/WindowFadeAnimation</item>

        <!-- Soft dim behind the floating card -->
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.4</item>

        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:navigationBarDividerColor" tools:targetApi="28">@android:color/transparent</item>

        <!-- Android 12+ splash: keep translucent dark so we don't flash solid black -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">#66000000</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@android:color/transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor" tools:targetApi="31">@android:color/transparent</item>
    </style>

    <style name="WindowFadeAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityCloseExitAnimation">@anim/slide_down_fade_out</item>
    </style>
</resources>
